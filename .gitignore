# Local-only bulk archive and scratch
/archive/
/tmp/

# Public-repository curation. These files remain on disk; older commits are not rewritten.
/docs/archive/
/analysis/out/
*.log
*.out
*.err
.pytest_cache/
*.egg-info/

# Root working notes; current scientific entry point is README + docs below.
/*.md
!/README.md
!/AGENTS.md

# Keep the current concise methods and the original experiment contract.
/docs/*.md
!/docs/METHODS.md
!/docs/CONTROLLED_GEOMETRY.md
!/docs/ACTION_CONDITION_SPECIFICITY.md
!/docs/ACTION_COUNTERFACTUAL.md
!/docs/PLANNING_CONTROL_LITERATURE.md
!/docs/INTERVENTION_MECHANISM_AUDIT.md
!/docs/CEM_EXPANSION.md
!/docs/PLANNED_PREFIX_REPLAY.md
!/docs/ANALYSIS_COMPLETION.md
!/docs/MECHANISMS.md
!/docs/LITERATURE_MECHANISMS.md
!/docs/PATHWAY_GEOMETRY.md
!/docs/PILOT_MECHANISMS.md
!/docs/RESULTS.md
!/docs/COMPUTE.md
!/docs/REPRODUCING.md
!/docs/EXPERIMENT_PLAN.md

# Manuscript drafts/old rendered figures are local; retain machine-readable evidence.
/paper/*
!/paper/data/
!/paper/data/**
!/paper/workshop/
/paper/workshop/*
!/paper/workshop/main.tex
!/paper/workshop/main.pdf
!/paper/workshop/references.bib
!/paper/workshop/neurips_2026.sty
!/paper/workshop/README.md

