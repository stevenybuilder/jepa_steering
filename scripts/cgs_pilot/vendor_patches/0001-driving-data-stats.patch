 """
 
+
+# --- cgs_pilot vendor patch (rep_geometry_transcoder/scripts/cgs_pilot/vendor_patches/
+#     0001-driving-data-stats.patch, 2026-09-02). Additive only: DROID and every other entry
+#     below are untouched. Registers the "driving" environment used by feature-trained
+#     predictors (scripts/cgs_pilot/train_feature_predictor.py, hubconf model_name
+#     "jepa_wm_driving" -> env "driving"). Actions are raw (normalize_action=False -> mean 0,
+#     std 1) exactly like the DROID entry; the dims come from the environment so one vendor
+#     copy serves A=2 (steer, throttle/brake) and A=3 arms alike.
+import os as _cgs_os
+
+
+def _cgs_driving_stats():
+    action_dim = int(_cgs_os.environ.get("JEPAWM_DRIVING_ACTION_DIM", "2"))
+    proprio_dim = int(_cgs_os.environ.get("JEPAWM_DRIVING_PROPRIO_DIM", "2"))
+    return {
+        "action_dim": action_dim,
+        "proprio_dim": proprio_dim,
+        "state_dim": proprio_dim,
+        "action_mean": [0.0] * action_dim,
+        "action_std": [1.0] * action_dim,
+        "proprio_mean": [0.0] * proprio_dim,
+        "proprio_std": [1.0] * proprio_dim,
+        "state_mean": [0.0] * proprio_dim,
+        "state_std": [1.0] * proprio_dim,
+    }
+
+
